# ===== LLM =====
DEEPSEEK_API_KEY=sk-xxxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_PROVIDER=deepseek
DEEPSEEK_TEMPERATURE=0.3
DEEPSEEK_MAX_TOKENS=1024

# ===== 路径（AutoDL 默认 /root/autodl-tmp，其它环境默认项目内 .data）=====
# DATA_ROOT=/root/autodl-tmp
# BGE_EMBED_PATH=/root/autodl-tmp/bge-small-zh-v1.5
# RERANKER_PATH=/root/autodl-tmp/models/bge-reranker-base
# CHROMA_PATH=/root/autodl-tmp/data/chroma

# ===== 存储 =====
MONGO_URI=mongodb://localhost:27017/
REDIS_URI=redis://localhost:6379/0
MONGO_DB=agentic_rag
SECRET_KEY=change-me-in-production

# ===== 检索 =====
EMBED_DIM=512
EMBED_MODEL_NAME=bge-small-zh-v1.5
CHUNK_SIZE=256
CHUNK_OVERLAP=20
TOP_K_RECALL=30
TOP_K_RERANK=5
RERANK_BACKEND=cross_encoder
SEMANTIC_CACHE_THRESHOLD=0.92

# ===== 队列 =====
QUEUE_BACKEND=kafka            # kafka | dev
KAFKA_BOOTSTRAP=localhost:9092
TOPIC_DOC_INGEST=doc_ingest
TOPIC_DOC_DLQ=doc_ingest_dlq
MAX_RETRY_DOC=3

# ===== API / 安全 =====
JWT_SECRET=change-me-too
JWT_EXPIRE_HOURS=24
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_CAPACITY=20
RATE_LIMIT_RATE=10

# ===== 数据库连接器安全护栏 =====
DB_QUERY_TIMEOUT=5
DB_MAX_ROWS=200
DB_SYNC_BATCH=500
DB_ALLOW_WRITE=false

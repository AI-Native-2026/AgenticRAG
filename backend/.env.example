# ===== LLM =====
DEEPSEEK_API_KEY=sk-xxxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_PROVIDER=deepseek
DEEPSEEK_TEMPERATURE=0.3
DEEPSEEK_MAX_TOKENS=1024

# ===== 路径（AutoDL 默认 /root/autodl-tmp，其它环境默认项目内 .data）=====
# DATA_ROOT=/root/autodl-tmp
# BGE_EMBED_PATH=/root/autodl-tmp/bge-small-zh-v1.5
# RERANKER_PATH=/root/autodl-tmp/models/bge-reranker-base
# CHROMA_PATH=/root/autodl-tmp/data/chroma

# ===== 存储 =====
MONGO_URI=mongodb://localhost:27017/
REDIS_URI=redis://localhost:6379/0
MONGO_DB=agentic_rag
SECRET_KEY=change-me-in-production

# ===== 检索 =====
EMBED_DIM=512
EMBED_MODEL_NAME=bge-small-zh-v1.5
CHUNK_SIZE=256
CHUNK_OVERLAP=20
TOP_K_RECALL=30
TOP_K_RERANK=5
RERANK_BACKEND=cross_encoder
SEMANTIC_CACHE_THRESHOLD=0.92

# ===== 队列 =====
QUEUE_BACKEND=kafka            # kafka | dev
KAFKA_BOOTSTRAP=localhost:9092
TOPIC_DOC_INGEST=doc_ingest
TOPIC_DOC_DLQ=doc_ingest_dlq
MAX_RETRY_DOC=3

# ===== API / 安全 =====
JWT_SECRET=change-me-too
JWT_EXPIRE_HOURS=24
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_CAPACITY=20
RATE_LIMIT_RATE=10

# ===== 数据库连接器安全护栏 =====
DB_QUERY_TIMEOUT=5
DB_MAX_ROWS=200
DB_SYNC_BATCH=500
DB_ALLOW_WRITE=false

# ===== 会话上下文管理 =====
MEMORY_TOKEN_LIMIT=3000          # 短期记忆 token 预算
MEMORY_RECENT_TURNS=6            # 保留最近 N 轮原文
MEMORY_SUMMARY_ENABLED=true      # 超窗历史压缩为长期摘要

# ===== 预览性能 =====
PREVIEW_MAX_CHARS=2000           # 单条预览最大字符
PREVIEW_PAGE_SIZE=10             # 文件列表每页
DISCOVER_MAX_FILES=5000          # 目录扫描上限

# ===== 隐私合规（预览脱敏） =====
PII_MASK_ENABLED=true
# 自定义正则，多个用 || 分隔
# PII_MASK_EXTRA=

# ===== 多媒体 / 富文档 =====
IMAGE_OCR_ENABLED=true
TESSERACT_LANG=chi_sim+eng
IMAGE_VLM_ENABLED=false
VLM_MODEL_PATH=/root/autodl-tmp/models/Qwen2.5-VL-3B-Instruct
PDF_OCR_ENABLED=false

# ===== 视觉问答（图片理解）=====
VLM_CHAT_ENABLED=true            # 上传图片+提问时用 VLM 直接理解图片
VLM_DEVICE=auto                  # auto | cuda | cpu

# ===== 多模态重排（可选） =====
# RERANK_BACKEND=cross_encoder   # cross_encoder | vl | llm | auto
VL_RERANKER_PATH=/root/autodl-tmp/models/Qwen3-VL-Reranker-2B
VL_EMBEDDING_PATH=/root/autodl-tmp/models/Qwen3-VL-Embedding-8B
VL_RERANK_MEDIA=false

# ===== 连接池 =====
MONGO_MAX_POOL=100

# ===== 限流 =====
RATE_LIMIT_CAPACITY=200
RATE_LIMIT_RATE=100
